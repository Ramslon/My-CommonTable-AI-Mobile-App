# Copy this file to `.env` and fill in your keys. Do NOT commit your real `.env`.

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (either key name is supported)
OPENAI_API_KEY=
OPENAI_KEY=
OPENAI_MODEL=gpt-4o-mini

# Hugging Face Inference API
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-3B-Instruct
HF_API_BASE=https://api-inference.huggingface.co/models
# Optional fallback model to try if the primary model returns 410/unsupported
HF_FALLBACK_MODEL=

# Nutrition enrichment (optional)
CALORIE_NINJAS_KEY=
